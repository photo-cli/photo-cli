{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "docker-debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "docker-run-debug",
            "program": "/app/PhotoCli.dll",
            "args": ["archive", "-o", "/photos/output", "-i", "/photos/input"],
            "cwd": "/app",
            "pipeTransport": {
                "pipeProgram": "docker",
                "pipeArgs": ["exec", "-i", "photocli-debug"],
                "debuggerPath": "/vsdbg/vsdbg",
                "pipeCwd": "${workspaceFolder}",
                "quoteArgs": false
            },
            "sourceFileMap": {
                "/src": "${workspaceFolder}"
            }
        },
        {
            "name": "archive",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/PhotoCli.dll",
            "args": ["archive"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "list",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/PhotoCli.dll",
            "args": ["list"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "copy",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/PhotoCli.dll",
            "args": ["copy"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "info",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/PhotoCli.dll",
            "args": ["info"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "address",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/PhotoCli.dll",
            "args": ["address"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "settings",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/PhotoCli.dll",
            "args": ["settings"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "help",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/PhotoCli.dll",
            "args": ["--help"],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        }
    ]
}